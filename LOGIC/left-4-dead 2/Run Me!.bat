@echo off
chcp 65001 >nul 2>&1
setlocal EnableExtensions
title Left 4 Dead 2

REM ============================================================
REM  Left 4 Dead 2
REM  Launcher generated by AnkerGames. Run from the extracted
REM  folder and keep the folder structure intact.
REM ============================================================

set "ROOT=%~dp0"
if "%ROOT:~-1%"=="\" set "ROOT=%ROOT:~0,-1%"
set "WORK_DIR=%ROOT%\Left 4 Dead 2"
set "TARGET=%ROOT%\Left 4 Dead 2\left4dead2.exe"

if not exist "%TARGET%" (
    echo(
    echo   Could not find:
    echo     "%TARGET%"
    echo(
    echo   The archive may not be fully extracted. Extract everything
    echo   ^(including all subfolders^) and run this file again.
    echo(
    pause
    exit /b 1
)

start "" /d "%WORK_DIR%" "%TARGET%" %*
exit /b 0
